# ============================================
# CONFIGURACIÓN PDF EXTRACTOR - ETAPA 1
# ============================================

# --- CONFIGURACIÓN BASE DE DATOS (MongoDB) ---
# Puerto por defecto donde va a correr el contenedor de Docker
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=pdf_extractor_db

# --- ENTORNO DE EJECUCIÓN ---
# "development" habilita la documentación interactiva (/docs y /redoc).
# En producción usar "production" (las docs quedan deshabilitadas por seguridad).
ENVIRONMENT=development

# --- LÍMITE DE ARCHIVOS ---
MAX_FILE_SIZE_MB=5

# --- SEGURIDAD: HOSTS CONFIABLES ---
# Lista separada por comas de valores válidos para el header Host.
ALLOWED_HOSTS=localhost,127.0.0.1,*.utn.edu.ar,pdf-extractor.utn.edu.ar

# ============================================
# NOTAS DE ARQUITECTURA (KISS / YAGNI):
# - PDF_FILE_PATH: Eliminado. Los PDFs viajan por red y se leen en RAM.
# - AI_PROVIDER / OLLAMA / MOONSHOT: Omitidos temporalmente. 
#   No son parte de los requerimientos de la Etapa 1.
# ============================================